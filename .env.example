# Neon Postgres connection string (Vercel Neon integration or neon.tech)
DATABASE_URL=postgresql://...
# Better Auth secret. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BETTER_AUTH_SECRET=
# Public base URL of the app
BETTER_AUTH_URL=http://localhost:3000
# GitHub OAuth app (GitHub > Settings > Developer settings > OAuth Apps).
# Authorization callback URL: $BETTER_AUTH_URL/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub usernames allowed to sign in (empty = nobody can sign in)
ALLOWED_GITHUB_USERS=
# Content repo (owner/repo) where articles, images, comments, and magazines are committed.
# Optional token for reading a private/rate-limited content repo (public repos can omit).
GITHUB_CONTENT_REPO=
GITHUB_CONTENT_TOKEN=
