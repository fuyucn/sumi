# =============================================================================
# Sumi 环境变量
# 下表按部署目标说明每个变量的用法。三个目标共享同一份 schema（src/lib/env.ts）：
#
# | 变量                     | Docker | VPS | Cloudflare (Workers)                  |
# |--------------------------|--------|-----|----------------------------------------|
# | DATABASE_URL             | ✅     | ✅  | ⭕ (由 D1 绑定 `DB` 提供，非此变量)      |
# | BETTER_AUTH_SECRET       | ✅     | ✅  | ✅ (作为 Worker 环境变量注入)           |
# | BETTER_AUTH_URL          | ✅     | ✅  | ✅                                     |
# | BETTER_AUTH_TRUSTED_ORIGINS | ⭕  | ⭕  | ⭕                                     |
# | GITHUB_CLIENT_ID/SECRET  | ✅     | ✅  | ✅                                     |
# | ALLOWED_GITHUB_USERS     | ✅     | ✅  | ✅                                     |
# | GITHUB_CONTENT_REPO      | ⭕     | ⭕  | ⭕ (GitHub 后端) / 由 CF 内容后端决定     |
# | GITHUB_CONTENT_TOKEN     | ⭕     | ⭕  | ⭕                                     |
# | CF_ENABLED               | ⭕     | ⭕  | ✅ 置为 "1" 时命中 Cloudflare 后端       |
# =============================================================================
#
# ---------------------------------------------------------------------------
# 数据库连接串。
# - Docker compose: 保持下方默认值（匹配 docker-compose.yml）
#   postgresql://sumi:sumi@db:5432/sumi
# - VPS / Vercel / Neon: 填你自己的数据库连接串。
# - Cloudflare: 不使用此变量，改用 wrangler.jsonc 中的 D1 绑定 `DB`。
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://sumi:sumi@db:5432/sumi

# Better Auth secret。生成: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BETTER_AUTH_SECRET=

# 应用公网地址（Docker/VPS 用于生产域名；本地开发默认 http://localhost:3000）
BETTER_AUTH_URL=http://localhost:3000

# 额外信任的 auth 来源（逗号分隔）。当通过本地代理/自定义域名访问时添加；
# Better Auth 默认只信任 BETTER_AUTH_URL + 此列表。
BETTER_AUTH_TRUSTED_ORIGINS=

# GitHub OAuth App（GitHub > Settings > Developer settings > OAuth Apps）。
# 授权回调地址: $BETTER_AUTH_URL/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 允许登录的 GitHub 用户名（逗号分隔；空 = 拒绝所有人）
ALLOWED_GITHUB_USERS=

# 内容仓库（owner/repo），文章/图片/评论/杂志将提交到此仓库。
# 可选 token 用于读取私有/限流内容仓库（公开仓库可省略）。
GITHUB_CONTENT_REPO=
GITHUB_CONTENT_TOKEN=

# Cloudflare 运行时开关（可选）。OpenNext 通过 Worker 绑定注入 D1/R2，
# 不写入 process.env；此变量仅供运行时选择 Cloudflare 内容后端使用。
# Docker/VPS 留空即可。置为 "1"（或任意非空）启用。
CF_ENABLED=
