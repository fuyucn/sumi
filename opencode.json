{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".claude/skills"]
  },
  "mcp": {
    "sumi-remote": {
      "type": "remote",
      "url": "http://localhost:3005/api/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:SUMI_API_KEY}"
      },
      "timeout": 15000
    },
    "sumi": {
      "type": "local",
      "command": ["node", "/Users/yuf/Developer/sumi/mcp/index.mjs"],
      "enabled": false,
      "timeout": 15000,
      "environment": {
        "SUMI_API_KEY": "{env:SUMI_API_KEY}",
        "SUMI_API_PRIVATE_KEY": "{env:SUMI_API_PRIVATE_KEY}",
        "SUMI_BASE_URL": "http://localhost:3005"
      }
    }
  }
}
